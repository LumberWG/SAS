# SAS 后端配置样例
# 复制为 .env 后按需修改；所有配置项均可通过环境变量覆盖
# 优先级：环境变量 > .env 文件 > 默认值

# ---------- 访问控制（公网部署必填） ----------
# 非空时所有 /api/* 都要求请求头 X-API-Token（或 Authorization: Bearer <token>），
# /api/health 例外（部署脚本与监控探活用）。
# 本机开发留空即可；经 cpolar/云主机公开时务必设置，否则拿到地址的人能读配置、
# 改交易参数、一键还原全部参数。前端首次访问会弹框要求输入，令牌只存本机浏览器。
API_TOKEN=

# ---------- LLM（可选模块） ----------
# 未配置时自动降级为技术面规则评分，其余功能完整可用
# 支持任意 OpenAI 兼容服务：DeepSeek / 通义千问 / 智谱 / OpenAI / Gemini
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# ---------- 通知管道（可选） ----------
# Webhook 机器人地址（企业微信/飞书/钉钉兼容），留空则仅控制台输出
NOTIFY_WEBHOOK_URL=
# 邮件通知（预留）
NOTIFY_EMAIL=false

# ---------- 定时任务 ----------
# 调度器总开关：盘中快照刷新(60s) / 异动检测(5min) / 收盘自动选股(15:30)
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
# 收盘自动选股策略（[] = 全部已注册策略；pydantic 要求 JSON 数组格式）
AUTO_SCAN_STRATEGIES=[]

# ---------- 影子账户（冻结参数的前向验证） ----------
# 起点为空 = 不启用；设定后每交易日 16:45 自动重跑「起点 ~ 今天」并落快照
# （data/logs/shadow_<tag>.json），只记录、不交易。起点写入后即冻结，改它需换 tag。
SHADOW_START=
SHADOW_TAG=live
SHADOW_UNIVERSE=300
# 逗号分隔的方案名；空 = 用 scripts/shadow.py 里的 DEFAULT_PROFILES
SHADOW_PROFILES=

# ---------- 智能建议 / 自动盯盘 ----------
# 收盘自动选股后，评分 Top N 的命中自动加入自选股
AUTO_WATCH_ENABLED=true
AUTO_WATCH_TOP_N=10
# 每轮手动扫描后，命中按评分 Top N 写入「程序自选」（0=关闭）
SCAN_AUTO_WATCH_LIMIT=50
# 盘中自选股分析间隔（分钟）
INTRADAY_ANALYSIS_INTERVAL=5
# 盘后「明日关注」数量
FOCUS_TOP_N=10

# ---------- 数据源 / 扫描 ----------
# 全市场扫描并发上限（被限流时可调低）
SCAN_CONCURRENCY=20
# 单股数据获取失败重试次数
FETCH_RETRIES=2
# 国内数据源直连（绕过不可用的系统代理）
DATA_DIRECT_ONLY=true
# 实时快照内存缓存 TTL（秒）。全量刷新约 90 秒，刷新期间并发请求
# 共享同一次刷新；调大可减少刷新频率，调小则行情更实时
SNAPSHOT_TTL=30

# ---------- 存储路径 ----------
# KLINE_DIR=data/klines
# DB_PATH=data/sas.db

# ---------- 模拟盘风控（弱市择时 + 动态机制降暴露） ----------
# 弱市（指数在 MA 下）暂停自动买入；>0 时弱市不暂停、只压总仓位上限
PAPER_REGIME_MA=60
PAPER_REGIME_WEAK_PAUSE=true
PAPER_WEAK_EXPOSURE=0.3
# 动态机制降暴露（机制检测层）：false=关闭（沿用上面静态档位，零风险）。
# true=由波动率/回撤/趋势把市场分 calm/weak/shock/crisis，动态压低总仓位上限（只降不升）。
PAPER_DYNAMIC_EXPOSURE=false
PAPER_REGIME_CAP_CALM=0.0
PAPER_REGIME_CAP_WEAK=0.30
PAPER_REGIME_CAP_SHOCK=0.40
PAPER_REGIME_CAP_CRISIS=0.15

# ---------- 政策托底强度检测 + 硬性回撤熔断（默认全部关闭，零风险） ----------
# 托底强度：weak/shock 态叠加"看不见的底"检测，分治为托底型阴跌(缩仓收割) / 自由落体型(升级危机防御)。
# 直接信号 ETF/期指/新闻缺失时自动降级为指数底部特征代理。
PAPER_POLICY_FLOOR_ENABLED=false
PAPER_POLICY_FLOOR_MIN_SCORE=0.50
PAPER_POLICY_FLOOR_LOW_ESCALATE=0.20
PAPER_POLICY_FLOOR_HARVEST_CAP=0.30
# 硬性回撤熔断：组合回撤≥dd 锁仓/压仓到 target，回落到≤release 才解除（滞回）；落库跨重启保留。
PAPER_CIRCUIT_BREAKER_ENABLED=false
PAPER_CIRCUIT_BREAKER_DD=0.08
PAPER_CIRCUIT_BREAKER_RELEASE=0.04
PAPER_CIRCUIT_BREAKER_TARGET=0.0

# ---------- 访问令牌 ----------
# 站点公网可达（cpolar）时必配：除 /api/health 外，所有 /api/* 都要带 X-API-Token。
# 留空 = 不校验，仅限纯本机开发。生成：
#   .\.venv\Scripts\python.exe -c "import secrets;print(secrets.token_urlsafe(24))"
# API_TOKEN=
