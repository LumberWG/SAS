# SAS 后端配置样例
# 复制为 .env 后按需修改；所有配置项均可通过环境变量覆盖
# 优先级：环境变量 > .env 文件 > 默认值

# ---------- LLM（可选模块） ----------
# 未配置时自动降级为技术面规则评分，其余功能完整可用
# 支持任意 OpenAI 兼容服务：DeepSeek / 通义千问 / 智谱 / OpenAI / Gemini
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# ---------- 通知管道（可选） ----------
# Webhook 机器人地址（企业微信/飞书/钉钉兼容），留空则仅控制台输出
NOTIFY_WEBHOOK_URL=
# 邮件通知（预留）
NOTIFY_EMAIL=false

# ---------- 定时任务 ----------
# 调度器总开关：盘中快照刷新(60s) / 异动检测(5min) / 收盘自动选股(15:30)
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
# 收盘自动选股策略（留空 = 全部已注册策略）
AUTO_SCAN_STRATEGIES=

# ---------- 数据源 / 扫描 ----------
# 全市场扫描并发上限（被限流时可调低）
SCAN_CONCURRENCY=20
# 单股数据获取失败重试次数
FETCH_RETRIES=2
# 国内数据源直连（绕过不可用的系统代理）
DATA_DIRECT_ONLY=true

# ---------- 存储路径 ----------
# KLINE_DIR=data/klines
# DB_PATH=data/sas.db
